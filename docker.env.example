# FreshMarket Admin Dashboard - Docker Environment
# Copy this file to .env for Docker deployment

# Database (Docker)
MYSQL_ROOT_PASSWORD=secure-root-password-2024
MYSQL_DATABASE=grocery_store
MYSQL_USER=grocery
MYSQL_PASSWORD=secure-grocery-password-2024

# Redis (Docker)
REDIS_PASSWORD=secure-redis-password-2024

# Application
JWT_SECRET=production-jwt-secret-key-change-this-in-production-2024
NEXT_PUBLIC_API_URL=http://api-gateway:80/api
DATABASE_URL=mysql://grocery:secure-grocery-password-2024@database:3306/grocery_store
REDIS_URL=redis://:secure-redis-password-2024@redis:6379
